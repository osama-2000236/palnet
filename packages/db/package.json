{
  "name": "@baydar/db",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "node": "./dist/index.js",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "generate": "node scripts/generate.mjs",
    "migrate:dev": "node scripts/migrate-dev.mjs",
    "db:generate": "node scripts/generate.mjs",
    "db:migrate": "node scripts/migrate-dev.mjs",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "qa:fixture": "tsx prisma/qa-fixture.ts",
    "qa:load-fixture": "tsx prisma/qa-load-fixture.ts",
    "qa:cleanup": "tsx prisma/qa-cleanup.ts",
    "lint": "eslint .",
    "test": "node --import tsx --test prisma/load-local-env.test.ts && node -e \"require('fs').mkdirSync('coverage',{recursive:true});require('fs').writeFileSync('coverage/node-test.txt','db tests passed\\n')\"",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/client": "^6.19.1"
  },
  "devDependencies": {
    "@baydar/config": "workspace:*",
    "@baydar/shared": "workspace:*",
    "@types/bcrypt": "^5.0.2",
    "@types/node": "^22.7.5",
    "bcrypt": "^5.1.1",
    "dotenv": "16.4.7",
    "prisma": "^6.19.1",
    "tsx": "^4.19.0",
    "typescript": "~5.9.2",
    "eslint": "^9.39.5"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
