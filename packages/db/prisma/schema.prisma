// Baydar — Prisma schema
// Authoritative data model. Any change here must:
//   1. Ship a migration in the same PR.
//   2. Update packages/shared/src/schemas/* if the shape is exposed to clients.
//   3. Update docs/erd.md.

generator client {
  provider = "prisma-client-js"
  // Full-text search for Postgres will be added via raw SQL GIN/tsvector in a
  // later migration (Sprint 5+). @@fulltext is MySQL-only in Prisma 5; do not
  // re-add it for Postgres.
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ──────────────────────────────────────────────────────────────────────────
// Enums
// ──────────────────────────────────────────────────────────────────────────

enum UserRole {
  USER
  COMPANY_ADMIN
  MODERATOR
  ADMIN
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  DECLINED
  WITHDRAWN
  BLOCKED
}

enum ReactionType {
  LIKE
  CELEBRATE
  SUPPORT
  LOVE
  INSIGHTFUL
  FUNNY
}

enum MediaKind {
  IMAGE
  VIDEO
  DOCUMENT
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  POST_REACTION
  POST_COMMENT
  POST_MENTION
  MESSAGE_RECEIVED
  JOB_APPLICATION_UPDATE
  JOB_ALERT
  PROFILE_VIEW
  MODERATION_ACTION
  STANDING_ADVANCED
  WORK_PROOF_REQUESTED
}

enum DevicePlatform {
  ios
  android
}

enum JobType {
  FULL_TIME
  PART_TIME
  CONTRACT
  TEMPORARY
  SEASONAL
  DAY_LABOR
  PIECE_WORK
  APPRENTICESHIP
  INTERNSHIP
  FREELANCE
  VOLUNTEER
}

// What the money is per. MONTHLY is the default so every pre-existing Job row
// keeps its meaning: salaryMin/salaryMax are a range *in this basis*.
enum PayBasis {
  MONTHLY
  DAILY
  HOURLY
  PER_JOB
  PER_PIECE
  COMMISSION
}

// What kind of business a Company is. One enum instead of a second model.
// EMPLOYER is the default, so existing rows are unchanged.
enum CompanyKind {
  EMPLOYER
  FIRM
  SHOP
  WORKSHOP
  FOOD
  FARM
  SOLO
}

// Only CONFIRMED counts toward a Standing, and the counterparty moves it there
// -- never the worker. docs/design/OCCUPATIONS.md sec 8.
enum WorkProofStatus {
  PENDING
  CONFIRMED
  DECLINED
  EXPIRED
  DISPUTED
}

enum StandingReason {
  EARNED
  VOUCHED
  FOUNDING
  SUSPENDED
  DEMOTED
  REINSTATED
}

enum PracticeStatus {
  TRAINEE
  PRACTISING
  NON_PRACTISING
}

enum LicenceStatus {
  DECLARED
  VERIFIED
  EXPIRED
}

enum TopicSource {
  AUTHOR_OCCUPATION
  HASHTAG
  COMPANY
  TEXT_MATCH
  GOVERNORATE
}

enum SignalKind {
  POST_EXPAND
  POST_DWELL
  LINK_CLICK
  PROFILE_VISIT
  SEARCH_QUERY
  JOB_APPLY
  NOT_INTERESTED
  HIDE_POST
}

enum RequirementLevel {
  MUST
  NICE
}

enum JobLocationMode {
  ONSITE
  HYBRID
  REMOTE
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
  WITHDRAWN
}

// Why an application was rejected. Required on every REJECTED transition —
// silence is the dominant complaint in a market with far more applicants than
// openings, and it is the cheapest one to fix.
enum RejectionReason {
  POSITION_FILLED
  EXPERIENCE_INSUFFICIENT
  SKILLS_MISMATCH
  LOCATION
  QUALIFICATION_MISSING
  APPLIED_AFTER_CLOSING
  OTHER
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  MISINFORMATION
  NUDITY
  VIOLENCE
  // Hiring fraud. The first six are a social-network's set and none of them is
  // "asked me for money" — the dominant local job scam, and the one thing a
  // worker most needs a name for.
  FEE_REQUEST
  GHOST_JOB
  ID_REQUEST
  OTHER
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  EDITOR
}

enum PlanCode {
  EMPLOYER_FREE
  EMPLOYER_BASIC
  EMPLOYER_PRO
  FEATURED_SLOT
  USER_PREMIUM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  POINTS
  JAWWALPAY
  PALPAY
  REFLECT
}

// A third member — the one that would have moved an application up a list —
// was removed here, deliberately and permanently. No ranking, ordering,
// scoring or filtering input in Baydar may come from a subscription, plan,
// credit or balance. scripts/check-naming.mjs bans its name, which is why this
// comment does not spell it.
enum EmployerCreditKind {
  FEATURED_SLOT
  JOB_POST
}

enum KaramaReason {
  PROFILE_COMPLETE
  ENDORSEMENT
  VERIFIED_HIRE
  RATING_RECEIVED
  REPORT_UPHELD
  FIRST_POST
  REDEEM_BOOST_APPLICATION
  REDEEM_PREMIUM
  REDEEM_FEATURED_PROFILE
  DECAY
  ADJUSTMENT
}

enum RatingContext {
  CANDIDATE_RATES_EMPLOYER
  EMPLOYER_RATES_CANDIDATE
}

enum BookmarkType {
  POST
  JOB
}

// ──────────────────────────────────────────────────────────────────────────
// Identity & Auth
// ──────────────────────────────────────────────────────────────────────────

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  emailVerified           DateTime?
  phone                   String?   @unique
  passwordHash            String
  role                    UserRole  @default(USER)
  locale                  String    @default("ar-PS")
  isActive                Boolean   @default(true)
  lastSeenAt              DateTime?
  karamaBalance           Int       @default(0)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?
  pendingDeletionSnapshot Json?
  notificationPreferences Json?

  profile                 Profile?
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sseStreamTokens         SseStreamToken[]
  sentConnections         Connection[]             @relation("ConnectionRequester")
  recvConnections         Connection[]             @relation("ConnectionReceiver")
  posts                   Post[]
  reactions               Reaction[]
  comments                Comment[]
  reposts                 Repost[]
  sentMessages            Message[]                @relation("MessageAuthor")
  chatMemberships         ChatRoomMember[]
  notifications           Notification[]           @relation("NotificationRecipient")
  notificationsSent       Notification[]           @relation("NotificationActor")
  deviceTokens            DeviceToken[]
  applications            Application[]
  companyMemberships      CompanyMember[]
  postedJobs              Job[]                    @relation("JobPoster")
  blockedByMe             BlockedUser[]            @relation("Blocker")
  blockedMe               BlockedUser[]            @relation("Blocked")
  reportsFiled            Report[]                 @relation("Reporter")
  subscriptions           Subscription[]
  invoices                Invoice[]
  karamaLedger            KaramaLedger[]
  ratingsGiven            UserRating[]             @relation("RatingRater")
  ratingsReceived         UserRating[]             @relation("RatingRatee")
  bookmarks               Bookmark[]
  jobAlerts               JobAlert[]
  workProofsAsWorker      WorkProof[]              @relation("WorkProofWorker")
  workProofsAsClient      WorkProof[]              @relation("WorkProofClient")
  standings               Standing[]
  vouchesGiven            Vouch[]                  @relation("VouchVoucher")
  vouchesReceived         Vouch[]                  @relation("VouchVouchee")
  licences                Licence[]
  interestWeights         InterestWeight[]
  feedSlates              FeedSlate[]
  topicMutes              TopicMute[]

  @@index([email])
  @@index([role])
}

model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  deviceId  String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  tokenHash       String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())
  requestedFromIp String?
  requestedFromUa String?

  @@index([tokenHash])
  @@index([userId])
}

model PasswordResetToken {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  tokenHash       String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())
  requestedFromIp String?
  requestedFromUa String?

  @@index([tokenHash])
  @@index([userId])
}

model SseStreamToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  scope      String
  createdAt  DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────────────────────────────────
// Profile
// ──────────────────────────────────────────────────────────────────────────

model Profile {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String   @unique
  handle             String   @unique // e.g. /in/osama-hamad
  firstName          String
  lastName           String
  headline           String?
  about              String?  @db.Text
  location           String? // city in Palestine, e.g. "Ramallah" or "رام الله"
  country            String   @default("PS")
  avatarUrl          String?
  coverUrl           String?
  website            String?
  pronouns           String?
  openToWork         Boolean  @default(false)
  hiring             Boolean  @default(false)
  // A self-employed practitioner is permanently taking work, which is not the
  // same fact as a salaried member job-hunting. Hence a second boolean.
  acceptingWork      Boolean  @default(false)
  // Whether this member visits the client, has a workshop, or both. A customer's
  // first question is "do you come to me?".
  servesAtClientSite Boolean  @default(false)
  hasWorkshop        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  experiences Experience[]
  educations  Education[]
  skills      ProfileSkill[]
  claims      OccupationClaim[]
  // FTS: add Postgres GIN index on (firstName || lastName || headline || about) via raw SQL migration.

  @@index([handle])
}

model Experience {
  id           String          @id @default(cuid())
  profile      Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  title        String
  companyName  String
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId    String?
  location     String?
  locationMode JobLocationMode @default(ONSITE)
  startDate    DateTime
  endDate      DateTime?
  description  String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([profileId])
  @@index([companyId])
}

model Education {
  id           String    @id @default(cuid())
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  school       String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  description  String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([profileId])
}

model Skill {
  id        String         @id @default(cuid())
  name      String         @unique
  slug      String         @unique
  createdAt DateTime       @default(now())
  profiles  ProfileSkill[]
}

model ProfileSkill {
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  skill        Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId      String
  endorsements Int     @default(0)

  @@id([profileId, skillId])
  @@index([skillId])
}

// ──────────────────────────────────────────────────────────────────────────
// Social graph
// ──────────────────────────────────────────────────────────────────────────

model Connection {
  id          String           @id @default(cuid())
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String
  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  message     String?          @db.Text
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@index([requesterId, status])
  @@index([status, createdAt])
}

model BlockedUser {
  id        String   @id @default(cuid())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ──────────────────────────────────────────────────────────────────────────
// Content
// ──────────────────────────────────────────────────────────────────────────

model Post {
  id           String    @id @default(cuid())
  // Work portfolio rides on posts: photos are the CV for most crafts, and this
  // way the portfolio inherits feed distribution, comments and reactions.
  // ponytail: no ordering or curation. Add a join table only if members ask to
  // reorder their samples.
  isWorkSample Boolean   @default(false)
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId     String
  body         String    @db.Text
  language     String    @default("ar")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  media     Media[]
  reactions Reaction[]
  comments  Comment[]
  topics    PostTopic[]
  reposts   Repost[]
  bookmarks Bookmark[]
  // FTS: raw SQL GIN index on body added in a later migration.

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([authorId, deletedAt, createdAt])
}

model Media {
  id         String    @id @default(cuid())
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String?
  url        String
  kind       MediaKind
  mimeType   String
  width      Int?
  height     Int?
  durationMs Int?
  sizeBytes  Int?
  blurhash   String?
  createdAt  DateTime  @default(now())

  @@index([postId])
}

model Reaction {
  id        String       @id @default(cuid())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  @@unique([userId, postId])
  @@index([postId, type])
}

model Comment {
  id        String    @id @default(cuid())
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  parentId  String?
  replies   Comment[] @relation("CommentReplies")
  body      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([postId, createdAt])
  @@index([authorId])
}

model Repost {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model Bookmark {
  id        String       @id @default(cuid())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      BookmarkType
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  job       Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([postId])
  @@index([jobId])
}

// ──────────────────────────────────────────────────────────────────────────
// Messaging
// ──────────────────────────────────────────────────────────────────────────

model ChatRoom {
  id        String   @id @default(cuid())
  isGroup   Boolean  @default(false)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ChatRoomMember[]
  messages Message[]
}

model ChatRoomMember {
  id                String    @id @default(cuid())
  room              ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  joinedAt          DateTime  @default(now())
  lastReadAt        DateTime?
  // Denormalized cursor for O(1) unread counts. Updated whenever the user
  // reads or sends a message in the room. NULL = never read anything.
  lastReadMessageId String?
  mutedUntil        DateTime?
  archivedAt        DateTime?

  @@unique([roomId, userId])
  @@index([userId])
  @@index([userId, roomId])
}

model Message {
  id              String    @id @default(cuid())
  room            ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId          String
  author          User      @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId        String
  body            String    @db.Text
  mediaUrl        String?
  clientMessageId String?
  createdAt       DateTime  @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?

  @@unique([roomId, authorId, clientMessageId])
  @@index([roomId, createdAt])
  @@index([authorId])
}

// ──────────────────────────────────────────────────────────────────────────
// Notifications
// ──────────────────────────────────────────────────────────────────────────

model Notification {
  id           String           @id @default(cuid())
  recipient    User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId  String
  actor        User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId      String?
  type         NotificationType
  // polymorphic reference — one of these is set
  postId       String?
  commentId    String?
  connectionId String?
  messageId    String?
  jobId        String?
  data         Json?
  readAt       DateTime?
  dismissedAt  DateTime?
  // Stable hash of (type, actorId, postId, commentId, connectionId, messageId,
  // jobId) used to collapse duplicate unread notifications without a 10-field
  // findFirst. NULL when dedupe is disabled for the emit call.
  dedupeKey    String?
  createdAt    DateTime         @default(now())

  @@index([recipientId, readAt])
  @@index([recipientId, dismissedAt])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, dedupeKey, readAt, dismissedAt])
}

model DeviceToken {
  id        String         @id @default(cuid())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  platform  DevicePlatform
  token     String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
}

// ──────────────────────────────────────────────────────────────────────────
// Jobs
// ──────────────────────────────────────────────────────────────────────────

model Company {
  id         String      @id @default(cuid())
  slug       String      @unique
  kind       CompanyKind @default(EMPLOYER)
  name       String
  tagline    String?
  about      String?     @db.Text
  website    String?
  industry   String?
  sizeBucket String? // "1-10", "11-50", ...
  logoUrl    String?
  coverUrl   String?
  country    String      @default("PS")
  city       String?
  verified   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  members       CompanyMember[]
  jobs          Job[]
  experiences   Experience[]
  subscriptions Subscription[]
  invoices      Invoice[]
  credits       EmployerCredit[]
  workProofs    WorkProof[]
  licences      Licence[]

  @@index([name])
  @@index([kind])
}

model CompanyMember {
  id        String            @id @default(cuid())
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      CompanyMemberRole @default(EDITOR)
  createdAt DateTime          @default(now())

  @@unique([companyId, userId])
  @@index([userId])
}

model Job {
  id                 String          @id @default(cuid())
  // Nullable on purpose: this one column is what lets an individual post
  // "need someone to rewire two rooms in Ramallah". postedById already carries
  // the human. Application -> HIRED -> two-sided UserRating then works
  // unchanged, which is where WorkProof gets its data.
  company            Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          String?
  postedBy           User            @relation("JobPoster", fields: [postedById], references: [id], onDelete: Cascade)
  postedById         String
  title              String
  description        String          @db.Text
  type               JobType
  locationMode       JobLocationMode
  city               String?
  country            String          @default("PS")
  // Structured requirements. Without these nothing can be matched: the old
  // skillsRequired String[] is free text and stays only for the long tail.
  occupationKey      String?
  minStanding        Int?
  requiresLicence    Boolean         @default(false)
  licenceBodyKey     String?
  // salaryMin/Max are a range *in payBasis*. MONTHLY default keeps every
  // existing row's meaning, so there is no data migration.
  payBasis           PayBasis        @default(MONTHLY)
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String?         @default("ILS")
  skillsRequired     String[]
  mustSkills         String[]
  startsAt           DateTime?
  durationDays       Int?
  screeningQuestions Json?
  isActive           Boolean         @default(true)
  expiresAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  applications Application[]
  bookmarks    Bookmark[]
  workProofs   WorkProof[]
  // FTS: raw SQL GIN index on (title || description) added in a later migration.

  @@index([companyId])
  @@index([isActive, createdAt])
  @@index([occupationKey, isActive])
  @@index([type, isActive])
}

// Saved job search → notification on matching new job. All filter fields are
// optional; creation requires at least one (enforced in the shared schema).
model JobAlert {
  id           String           @id @default(cuid())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  q            String?
  city         String?
  type         JobType?
  locationMode JobLocationMode?
  industry     String?
  createdAt    DateTime         @default(now())

  @@index([userId])
}

model Application {
  id               String            @id @default(cuid())
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId            String
  applicant        User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applicantId      String
  resumeUrl        String?
  coverLetter      String?           @db.Text
  // Structure the employer currently reconstructs by reading PDFs.
  screeningAnswers Json?
  expectedPay      Int?
  expectedPayBasis PayBasis?
  availableFrom    DateTime?
  attachedProofIds String[]
  portfolioPostIds String[]
  // The score AS COMPUTED AT SUBMISSION, with its weights version. Frozen, so a
  // later profile edit or a weight change cannot rewrite a past decision.
  matchSnapshot    Json?
  status           ApplicationStatus @default(SUBMITTED)
  // Set together, cleared together, and only ever on REJECTED. The note is the
  // free text OTHER needs to mean anything to the applicant.
  rejectionReason  RejectionReason?
  rejectionNote    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  workProofs WorkProof[]

  @@unique([jobId, applicantId])
  @@index([applicantId])
  @@index([jobId, status])
}

// ──────────────────────────────────────────────────────────────────────────
// Moderation
// ──────────────────────────────────────────────────────────────────────────

model Report {
  id              String       @id @default(cuid())
  reporter        User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId      String
  reason          ReportReason
  details         String?      @db.Text
  targetUserId    String?
  targetPostId    String?
  targetCommentId String?
  targetMessageId String?
  resolvedAt      DateTime?
  resolvedNote    String?      @db.Text
  createdAt       DateTime     @default(now())

  @@index([reporterId])
  @@index([resolvedAt])
}

model ModerationAction {
  id           String   @id @default(cuid())
  actorId      String
  reportId     String?
  action       String
  note         String?  @db.Text
  targetUserId String?
  createdAt    DateTime @default(now())

  @@index([reportId])
  @@index([actorId])
  @@index([targetUserId])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────────────────
// Monetization — plans, subscriptions, invoices, payments, Karama Points,
// peer ratings. Source of truth is the ledger / invoice tables; balances
// denormalize for fast reads.
// ──────────────────────────────────────────────────────────────────────────

model Plan {
  id           String   @id @default(cuid())
  code         PlanCode @unique
  name         String
  priceCents   Int      @default(0)
  currency     String   @default("USD")
  intervalDays Int? // null = one-off (e.g. featured slot)
  features     Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions Subscription[]
  invoices      Invoice[]
}

model Subscription {
  id                     String             @id @default(cuid())
  user                   User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String?
  company                Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId              String?
  plan                   Plan               @relation(fields: [planId], references: [id])
  planId                 String
  status                 SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  providerSubscriptionId String?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  invoices Invoice[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model Invoice {
  id                String        @id @default(cuid())
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionId    String?
  plan              Plan?         @relation(fields: [planId], references: [id])
  planId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId            String?
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId         String?
  amountCents       Int
  currency          String        @default("USD")
  status            InvoiceStatus @default(OPEN)
  method            PaymentMethod @default(CARD)
  providerInvoiceId String?
  bankReceiptUrl    String?
  dueAt             DateTime?
  paidAt            DateTime?
  pdfUrl            String?
  // Operator review audit trail (bank-transfer review queue): who approved or
  // voided the invoice, when, and the stated reason. Null for automated paths.
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payments Payment[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model Payment {
  id                String   @id @default(cuid())
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId         String
  providerPaymentId String?
  amountCents       Int
  currency          String   @default("USD")
  status            String // provider-specific status string
  rawPayload        Json?
  createdAt         DateTime @default(now())

  @@index([invoiceId])
}

model EmployerCredit {
  id        String             @id @default(cuid())
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  kind      EmployerCreditKind
  remaining Int                @default(0)
  expiresAt DateTime?
  createdAt DateTime           @default(now())

  @@index([companyId, kind])
}

model KaramaLedger {
  id           String       @id @default(cuid())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  delta        Int
  balanceAfter Int
  reason       KaramaReason
  refType      String?
  refId        String?
  createdAt    DateTime     @default(now())

  @@unique([userId, reason, refType, refId])
  @@index([userId, createdAt])
  @@index([reason])
}

model UserRating {
  id            String        @id @default(cuid())
  rater         User          @relation("RatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  raterId       String
  ratee         User          @relation("RatingRatee", fields: [rateeId], references: [id], onDelete: Cascade)
  rateeId       String
  context       RatingContext
  score         Int // 1–5
  comment       String?       @db.Text
  jobId         String?
  applicationId String?
  createdAt     DateTime      @default(now())

  @@unique([raterId, rateeId, context, jobId])
  @@index([rateeId, context])
  @@index([raterId])
}

// ──────────────────────────────────────────────────────────────────────────
// Occupations, standing and evidence
//
// docs/design/OCCUPATIONS.md is the decision record. The naming spine there is
// law: one concept, one word, and scripts/check-naming.mjs fails CI on a
// synonym. Occupation keys are constants in @baydar/shared, not a table --
// same reasoning as PS_CITIES.
// ──────────────────────────────────────────────────────────────────────────

// A member's claim on an occupation. Declared, unproven -- rendered as
// «مهنة معلنة». Evidence is what turns it into a Standing or backs a Licence.
model OccupationClaim {
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId     String
  occupationKey String
  declaredYears Int?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@id([profileId, occupationKey])
  @@index([occupationKey])
}

// One finished unit of work a counterparty confirmed. THE evidence primitive:
// all three tracks accumulate these and differ only in how they are summarised.
//
// Counted once, keyed on (workerId, occupationKey, applicationId) -- a hire
// status toggled HIRED -> REJECTED -> HIRED advances nothing the second time.
// That is the exact attack that minted Karama in the round-2 review.
model WorkProof {
  id               String          @id @default(cuid())
  worker           User            @relation("WorkProofWorker", fields: [workerId], references: [id], onDelete: Cascade)
  workerId         String
  // Who confirms. Exactly one of these is set; the worker may never be either.
  clientUser       User?           @relation("WorkProofClient", fields: [clientUserId], references: [id], onDelete: SetNull)
  clientUserId     String?
  clientCompany    Company?        @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)
  clientCompanyId  String?
  occupationKey    String
  job              Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobId            String?
  application      Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  applicationId    String?
  city             String?
  summary          String?         @db.Text
  status           WorkProofStatus @default(PENDING)
  completedAt      DateTime?
  // Confirmation is bounded: an unanswered request expires rather than hanging
  // around as leverage.
  confirmExpiresAt DateTime?
  confirmedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([workerId, occupationKey, applicationId])
  @@index([workerId, occupationKey, status])
  @@index([clientUserId])
  @@index([status, confirmExpiresAt])
}

// Earned level, CRAFT track only -- 1..4. One row per (user, occupation),
// written only on transition so the "you advanced" notification has a diff.
// Never recomputed on read, never decays, and no billing or karama code path
// may write it.
model Standing {
  id            String         @id @default(cuid())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  occupationKey String
  value         Int
  reason        StandingReason @default(EARNED)
  // Set when an upheld report suspends the standing. Suspension, not decay.
  suspendedAt   DateTime?
  attainedAt    DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, occupationKey])
  @@index([occupationKey, value])
}

// A معلّم sponsoring someone onto the ladder. Skin in the game: if the vouchee's
// work is disputed and upheld, the voucher loses vouch capacity for a window,
// or this is a favour economy.
model Vouch {
  id            String    @id @default(cuid())
  voucher       User      @relation("VouchVoucher", fields: [voucherId], references: [id], onDelete: Cascade)
  voucherId     String
  vouchee       User      @relation("VouchVouchee", fields: [voucheeId], references: [id], onDelete: Cascade)
  voucheeId     String
  occupationKey String
  note          String?   @db.Text
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@unique([voucherId, voucheeId, occupationKey])
  @@index([voucheeId, occupationKey])
}

// Statutory practice licence, LICENSED track only. Baydar verifies; it never
// invents a rank beside a نقابة. Body keys are constants in @baydar/shared.
// Held by a member, or by a FIRM for its practice.
model Licence {
  id            String         @id @default(cuid())
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String?
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String?
  occupationKey String
  bodyKey       String
  number        String?
  status        LicenceStatus  @default(DECLARED)
  practice      PracticeStatus @default(PRACTISING)
  issuedAt      DateTime?
  expiresAt     DateTime?
  verifiedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, occupationKey, bodyKey])
  @@index([companyId])
  @@index([status, expiresAt])
}

// ──────────────────────────────────────────────────────────────────────────
// Feed ranking -- docs/design/FEED-RANKING.md
// ──────────────────────────────────────────────────────────────────────────

// Deterministic tags written once on post create. No ML, no model to host:
// author occupations, hashtags, company mentions, folded-Arabic taxonomy match,
// and the author's governorate.
model PostTopic {
  post     Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   String
  topicKey String
  source   TopicSource

  @@id([postId, topicKey])
  @@index([topicKey])
}

// Sparse topic interest, updated by EWMA on signal arrival and decayed on read.
// Embeddings would rank marginally better and cost the ability to say WHY a
// post was shown, which is the whole reason ranking is acceptable here.
// ponytail: sparse topics in Postgres; revisit only if explainability stops
// being a product requirement.
model InterestWeight {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  topicKey  String
  weight    Float    @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, topicKey])
  @@index([userId, weight])
}

// A frozen ranked page order. Score-ordered results plus a cursor duplicates
// and skips posts, because cursor pagination assumes a stable total order and a
// ranked feed has none. Paging walks an offset into postIds instead.
model FeedSlate {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  postIds     String[]
  generatedAt DateTime @default(now())
  expiresAt   DateTime

  @@index([userId, generatedAt])
  @@index([expiresAt])
}

// Negative feedback. Without a correction signal the interest model has no way
// to be wrong, so this ships with the model, not after it.
model TopicMute {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  topicKey  String
  createdAt DateTime @default(now())

  @@id([userId, topicKey])
}
