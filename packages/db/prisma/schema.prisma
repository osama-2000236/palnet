  REMOTE
}

enum ApplicationStatus {
  SUBMITTED
  REVIEWING
  SHORTLISTED
  REJECTED
  HIRED
  WITHDRAWN
}

// Why an application was rejected. Required on every REJECTED transition —
// silence is the dominant complaint in a market with far more applicants than
// openings, and it is the cheapest one to fix.
enum RejectionReason {
  POSITION_FILLED
  EXPERIENCE_INSUFFICIENT
  SKILLS_MISMATCH
  LOCATION
  QUALIFICATION_MISSING
  APPLIED_AFTER_CLOSING
  OTHER
}

enum ReportReason {
  SPAM
  HARASSMENT
  HATE
  MISINFORMATION
  NUDITY
  VIOLENCE
  // Hiring fraud. The first six are a social-network's set and none of them is
  // "asked me for money" — the dominant local job scam, and the one thing a
  // worker most needs a name for.
  FEE_REQUEST
  GHOST_JOB
  ID_REQUEST
  OTHER
}

enum CompanyMemberRole {
  OWNER
  ADMIN
  EDITOR
}

enum PlanCode {
  EMPLOYER_FREE
  EMPLOYER_BASIC
  EMPLOYER_PRO
  FEATURED_SLOT
  USER_PREMIUM
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum InvoiceStatus {
  DRAFT
  OPEN
  PAID
  VOID
  UNCOLLECTIBLE
}

enum PaymentMethod {
  CARD
  BANK_TRANSFER
  POINTS
  JAWWALPAY
  PALPAY
  REFLECT
}

// A third member — the one that would have moved an application up a list —
// was removed here, deliberately and permanently. No ranking, ordering,
// scoring or filtering input in Baydar may come from a subscription, plan,
// credit or balance. scripts/check-naming.mjs bans its name, which is why this
// comment does not spell it.
enum EmployerCreditKind {
  FEATURED_SLOT
  JOB_POST
}

enum KaramaReason {
  PROFILE_COMPLETE
  ENDORSEMENT
  VERIFIED_HIRE
  RATING_RECEIVED
  REPORT_UPHELD
  FIRST_POST
  REDEEM_BOOST_APPLICATION
  REDEEM_PREMIUM
  REDEEM_FEATURED_PROFILE
  DECAY
  ADJUSTMENT
}

enum RatingContext {
  CANDIDATE_RATES_EMPLOYER
  EMPLOYER_RATES_CANDIDATE
}

// Self-reported, and labelled as such. A test would be a product Baydar does
// not run, and an unlabelled self-report is the kind of small lie that makes a
// whole profile untrustworthy.
enum LanguageLevel {
  BASIC
  CONVERSATIONAL
  PROFESSIONAL
  NATIVE
}

// How the author knew the subject. Required, because "worked with" covers a
// manager and a supplier and those are not the same testimonial.
enum RecommendationRelation {
  MANAGED_DIRECTLY
  REPORTED_TO_ME
  SAME_TEAM
  DIFFERENT_TEAM
  CLIENT_OF
  SUPPLIER_TO
  TAUGHT
  STUDIED_UNDER
}

enum RecommendationStatus {
  PENDING
  PUBLISHED
  DECLINED
  WITHDRAWN
}

// The four identity checks that exist in this market. LinkedIn's CLEAR and
// NFC-passport paths do not: neither operates here, and a product that asks
// for a document it cannot verify is asking for a photograph of an ID.
enum VerificationMethod {
  PHONE
  WORK_EMAIL
  EDU_EMAIL
  PROFESSIONAL_BODY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  FAILED
  REVOKED
  EXPIRED
}

enum OtpPurpose {
  PHONE_VERIFY
  WORK_PROOF_CONFIRM
  ACCOUNT_RECOVERY
}

// Arabic requires grammatical gender agreement in verbs and adjectives
// addressed to the reader. This is a rendering input, not a pronoun: a
// second-person imperative addressed to a woman is a different word, and
// getting it wrong in every string is what a native speaker notices first.
enum AddressGender {
  FEMININE
  MASCULINE
  NEUTRAL_PLURAL
}

// Why the gap. DISPLACEMENT and DETENTION are not optional here — a gap this
// market produces must not read as unemployability, and the only way to stop
// that is to let it be named.
enum CareerBreakReason {
  CAREER_BREAK_STUDY
  CAREER_BREAK_CARE
  CAREER_BREAK_HEALTH
  CAREER_BREAK_DISPLACEMENT
  CAREER_BREAK_DETENTION
  CAREER_BREAK_TRAVEL
  CAREER_BREAK_OTHER
}

// The asymmetric edge. Baydar had exactly one — Connection, mutual, requiring
// acceptance — which caps the diaspora's participation at the size of their
// existing address book. 8.82 million people abroad mostly do not know each
// other and never will; a follow costs the person being followed nothing.
enum FollowTargetType {
  USER
  COMPANY
  TOPIC
}

enum BookmarkType {
  POST
  JOB
}

// ──────────────────────────────────────────────────────────────────────────
// Identity & Auth
// ──────────────────────────────────────────────────────────────────────────

model User {
  id                      String    @id @default(cuid())
  email                   String    @unique
  emailVerified           DateTime?
  phone                   String?   @unique
  passwordHash            String
  role                    UserRole  @default(USER)
  locale                  String    @default("ar-PS")
  isActive                Boolean   @default(true)
  lastSeenAt              DateTime?
  karamaBalance           Int       @default(0)
  /// Set once a PHONE verification succeeds. Denormalised from Verification so
  /// the common check -- "can this account be trusted with an off-platform work
  /// proof" -- is one column rather than a join.
  phoneVerifiedAt         DateTime?
  /// An upheld dispute against somebody this member vouched for drops their
  /// vouch capacity to zero until this date. Suspension, not revocation: the
  /// existing vouches stay, because revoking them would punish the vouchees
  /// rather than the voucher.
  vouchSuspendedUntil     DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
  deletedAt               DateTime?
  pendingDeletionSnapshot Json?
  notificationPreferences Json?

  profile                 Profile?
  refreshTokens           RefreshToken[]
  emailVerificationTokens EmailVerificationToken[]
  passwordResetTokens     PasswordResetToken[]
  sseStreamTokens         SseStreamToken[]
  sentConnections         Connection[]             @relation("ConnectionRequester")
  recvConnections         Connection[]             @relation("ConnectionReceiver")
  posts                   Post[]
  reactions               Reaction[]
  comments                Comment[]
  reposts                 Repost[]
  sentMessages            Message[]                @relation("MessageAuthor")
  chatMemberships         ChatRoomMember[]
  notifications           Notification[]           @relation("NotificationRecipient")
  notificationsSent       Notification[]           @relation("NotificationActor")
  deviceTokens            DeviceToken[]
  applications            Application[]
  companyMemberships      CompanyMember[]
  postedJobs              Job[]                    @relation("JobPoster")
  blockedByMe             BlockedUser[]            @relation("Blocker")
  blockedMe               BlockedUser[]            @relation("Blocked")
  reportsFiled            Report[]                 @relation("Reporter")
  subscriptions           Subscription[]
  invoices                Invoice[]
  karamaLedger            KaramaLedger[]
  ratingsGiven            UserRating[]             @relation("RatingRater")
  ratingsReceived         UserRating[]             @relation("RatingRatee")
  bookmarks               Bookmark[]
  jobAlerts               JobAlert[]
  workProofsAsWorker      WorkProof[]              @relation("WorkProofWorker")
  workProofsAsClient      WorkProof[]              @relation("WorkProofClient")
  standings               Standing[]
  vouchesGiven            Vouch[]                  @relation("VouchVoucher")
  vouchesReceived         Vouch[]                  @relation("VouchVouchee")
  licences                Licence[]
  interestWeights         InterestWeight[]
  feedSlates              FeedSlate[]
  topicMutes              TopicMute[]
  idempotencyRecords      IdempotencyRecord[]
  follows                 Follow[]                 @relation("FollowFollower")
  followers               Follow[]                 @relation("FollowTargetUser")
  feedMutes               FeedMute[]               @relation("FeedMuteUser")
  feedMutedBy             FeedMute[]               @relation("FeedMuteMuted")
  restrictionsMade        RestrictedUser[]         @relation("RestrictOwner")
  restrictedBy            RestrictedUser[]         @relation("RestrictTarget")
  secondDegree            SecondDegree[]           @relation("SecondDegreeUser")
  secondDegreeOf          SecondDegree[]           @relation("SecondDegreePeer")
  suggestionDismissals    SuggestionDismissal[]    @relation("DismissalUser")
  dismissedBy             SuggestionDismissal[]    @relation("DismissalTarget")
  verifications           Verification[]
  recommendationsWritten  Recommendation[]         @relation("RecommendationAuthor")
  recommendationsReceived Recommendation[]         @relation("RecommendationSubject")

  @@index([email])
  @@index([role])
}

// Replay protection for the writes a client may retry.
//
// A member on 2G sends a post, the request times out at 40 seconds, the outbox
// retries, and without this the post exists twice. `Message` already solves it
// with @@unique([roomId, authorId, clientMessageId]); this generalises the same
// idea to every write that has no natural uniqueness.
//
// It stores the original response rather than just the key, so a replay returns
// the identical body and status. Returning 409 would be technically correct and
// useless: the client asked "did my post save?" and a conflict does not answer
// it, while the saved post does.
//
// `expiresAt` is 48 hours out — long enough to cover an outbox that has been
// queued through an outage, short enough that this table does not become an
// archive of every write in the product.
model IdempotencyRecord {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  key          String
  /// The route the key was first used on. A key replayed against a different
  /// route is a client bug, and answering it with another route's response
  /// would be a data leak rather than a retry.
  route        String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([userId, key])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────────────────────────────────
// The graph
// ──────────────────────────────────────────────────────────────────────────

// One row per follow. Exactly one target column is set; the migration adds a
// CHECK for it, because Prisma cannot express "one of three" and a row with
// two targets is counted twice by FollowerCount forever.
model Follow {
  id              String           @id @default(cuid())
  follower        User             @relation("FollowFollower", fields: [followerId], references: [id], onDelete: Cascade)
  followerId      String
  targetType      FollowTargetType
  targetUser      User?            @relation("FollowTargetUser", fields: [targetUserId], references: [id], onDelete: Cascade)
  targetUserId    String?
  targetCompany   Company?         @relation(fields: [targetCompanyId], references: [id], onDelete: Cascade)
  targetCompanyId String?
  targetTopicKey  String?
  /// "USER:<id>" | "COMPANY:<id>" | "TOPIC:<key>". Derived by followTargetKey()
  /// in @baydar/shared so both sides spell it the same way.
  ///
  /// Uniqueness cannot be expressed over the three nullable columns: Postgres
  /// treats NULLs in a unique index as distinct, so (me, USER, u2, NULL, NULL)
  /// would happily insert twice and FollowerCount would count both.
  targetKey       String
  createdAt       DateTime         @default(now())

  @@unique([followerId, targetKey])
  @@index([targetUserId])
  @@index([targetCompanyId])
  @@index([targetTopicKey])
  @@index([followerId, targetType])
}

/// Denormalised, because a COUNT(*) on Follow per profile card is the query
/// that kills the feed at 100k rows. Incremented with UPDATE … SET count =
/// count + 1 inside the same transaction as the Follow write — never
/// read-modify-write, which loses a follow under concurrency.
model FollowerCount {
  /// The same key Follow carries. One column rather than the four the design
  /// sketched: Prisma cannot build a primary key from nullable fields, and a
  /// counter needs a key it can upsert on atomically.
  targetKey  String           @id
  targetType FollowTargetType
  count      Int              @default(0)
  updatedAt  DateTime         @updatedAt

  @@index([targetType])
}

/// "Stop showing me this person's posts, but stay connected." Distinct from
/// BlockedUser, which is mutual invisibility, and from unfollowing, which this
/// does not touch — the connection and the follow both survive.
model FeedMute {
  user      User     @relation("FeedMuteUser", fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  muted     User     @relation("FeedMuteMuted", fields: [mutedId], references: [id], onDelete: Cascade)
  mutedId   String
  createdAt DateTime @default(now())

  @@id([userId, mutedId])
  @@index([mutedId])
}

/// They can see me; they cannot message me or comment on my posts. The safety
/// primitive between "nothing" and "block", for the case where blocking is
/// itself a signal the other person would notice.
model RestrictedUser {
  user         User     @relation("RestrictOwner", fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  restricted   User     @relation("RestrictTarget", fields: [restrictedId], references: [id], onDelete: Cascade)
  restrictedId String
  createdAt    DateTime @default(now())

  @@id([userId, restrictedId])
  @@index([restrictedId])
}

/// Materialised second-degree adjacency, refreshed nightly. Computing degree
/// live is a two-hop join per card, which at feed scale is not affordable.
/// Only degree 2 is stored — degree 3 renders as "3rd+" without proof, which
/// is honest enough and costs nothing.
model SecondDegree {
  user        User     @relation("SecondDegreeUser", fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  peer        User     @relation("SecondDegreePeer", fields: [peerId], references: [id], onDelete: Cascade)
  peerId      String
  /// Shared first-degree connections. Drives «٤ معارف مشتركين».
  mutuals     Int
  refreshedAt DateTime @default(now())

  @@id([userId, peerId])
  @@index([userId, mutuals])
}

/// "Not this person." Suggestions that ignore a dismissal are worse than no
/// suggestions: they teach the member that the control does nothing.
model SuggestionDismissal {
  user        User     @relation("DismissalUser", fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  dismissed   User     @relation("DismissalTarget", fields: [dismissedId], references: [id], onDelete: Cascade)
  dismissedId String
  createdAt   DateTime @default(now())

  @@id([userId, dismissedId])
  @@index([createdAt])
}

model RefreshToken {
  id        String    @id @default(cuid())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  tokenHash String    @unique
  deviceId  String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model EmailVerificationToken {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  tokenHash       String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())
  requestedFromIp String?
  requestedFromUa String?

  @@index([tokenHash])
  @@index([userId])
}

model PasswordResetToken {
  id              String    @id @default(cuid())
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId          String
  tokenHash       String
  expiresAt       DateTime
  consumedAt      DateTime?
  createdAt       DateTime  @default(now())
  requestedFromIp String?
  requestedFromUa String?

  @@index([tokenHash])
  @@index([userId])
}

model SseStreamToken {
  id         String    @id @default(cuid())
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  tokenHash  String
  expiresAt  DateTime
  consumedAt DateTime?
  scope      String
  createdAt  DateTime  @default(now())

  @@index([tokenHash])
  @@index([userId])
  @@index([expiresAt])
}

// ──────────────────────────────────────────────────────────────────────────
// Profile
// ──────────────────────────────────────────────────────────────────────────

model Profile {
  id                 String   @id @default(cuid())
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId             String   @unique
  handle             String   @unique // e.g. /in/osama-hamad
  firstName          String
  lastName           String
  headline           String?
  about              String?  @db.Text
  location           String? // city in Palestine, e.g. "Ramallah" or "رام الله"
  country            String   @default("PS")
  avatarUrl          String?
  coverUrl           String?
  website            String?
  pronouns           String?
  openToWork         Boolean  @default(false)
  hiring             Boolean  @default(false)
  // A self-employed practitioner is permanently taking work, which is not the
  // same fact as a salaried member job-hunting. Hence a second boolean.
  acceptingWork      Boolean  @default(false)
  // Whether this member visits the client, has a workshop, or both. A customer's
  // first question is "do you come to me?".
  servesAtClientSite Boolean  @default(false)
  hasWorkshop        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  /// Where this member IS. `country` carried both meanings; origin is a
  /// separate, optional fact now, because 8.82 million Palestinians abroad
  /// against 5.56 million at home makes "where from" and "where now" two
  /// different questions.
  residenceCountry  String   @default("PS")
  /// PS_GOVERNORATES key. The one thing the diaspora reliably shares.
  originGovernorate String?
  diasporaVisible   Boolean  @default(true)

  /// Replaces `pronouns`, which had no consumer. Arabic verb and adjective
  /// agreement needs this; NULL renders neutral-plural, which is what the
  /// catalogs already assume and the safe default when nobody has said.
  addressGender AddressGender?

  /// A conflict-driven gap must not read as unemployability, and the only way
  /// to stop that is to let it be named.
  careerBreakFrom   DateTime?
  careerBreakTo     DateTime?
  careerBreakReason CareerBreakReason?

  /// Cached, recomputed on write, never on read. Avoids a five-table fan-out
  /// per person card. Used only to order a candidate list an employer already
  /// opened -- never the feed, never public search, and no paid input touches
  /// it (Rule 1).
  evidenceScore Int @default(0)

  experiences    Experience[]
  educations     Education[]
  skills         ProfileSkill[]
  claims         OccupationClaim[]
  certificates   Certificate[]
  languages      ProfileLanguage[]
  volunteerRoles VolunteerRole[]
  honors         Honor[]
  publications   Publication[]
  translations   ProfileTranslation[]
  viewDays       ProfileViewDaily[]
  // FTS: add Postgres GIN index on (firstName || lastName || headline || about) via raw SQL migration.

  @@index([handle])
  @@index([originGovernorate])
  @@index([residenceCountry])
}

// --------------------------------------------------------------------------
// Profile sections
// --------------------------------------------------------------------------

/// A non-statutory training credential. Renders as a certificate and never as
/// a licence: that claims something Baydar has not verified, and a licence
/// claim is a legal exposure rather than a wording preference.
model Certificate {
  id            String    @id @default(cuid())
  profile       Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId     String
  name          String
  issuerName    String
  /// PS_ISSUERS key when the issuer is one we know how to spell consistently.
  issuerKey     String?
  credentialId  String?
  credentialUrl String?
  issuedAt      DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([profileId])
  @@index([issuerKey])
}

model ProfileLanguage {
  profile     Profile       @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  /// BCP-47 primary subtag: ar, en, he, fr, tr, de, es.
  languageKey String
  proficiency LanguageLevel

  @@id([profileId, languageKey])
}

model VolunteerRole {
  id           String    @id @default(cuid())
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  role         String
  organisation String
  /// PS_CAUSE_KEYS. Six only: these describe work somebody did, which is a
  /// different thing from "causes you care about".
  causeKey     String?
  startDate    DateTime
  endDate      DateTime?
  description  String?   @db.Text
  createdAt    DateTime  @default(now())

  @@index([profileId])
}

model Honor {
  id          String    @id @default(cuid())
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  title       String
  issuerName  String
  awardedAt   DateTime?
  description String?   @db.Text
  createdAt   DateTime  @default(now())

  @@index([profileId])
}

model Publication {
  id          String    @id @default(cuid())
  profile     Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId   String
  title       String
  venue       String?
  url         String?
  publishedAt DateTime?
  createdAt   DateTime  @default(now())

  @@index([profileId])
}

/// The profile in a second language. The diaspora needs an English one; the
/// local market needs Arabic. The member writes both -- a machine-translated
/// headline in a hiring context is worse than none.
model ProfileTranslation {
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId String
  /// "en" only, for now.
  locale    String
  firstName String
  lastName  String
  headline  String?
  about     String?  @db.Text
  updatedAt DateTime @updatedAt

  @@id([profileId, locale])
}

/// Aggregate view counters, not per-view rows.
///
/// A view table at this scale is a privacy liability and an index-bloat
/// problem, and named viewers are never sold here. The breakdowns are
/// k-anonymised at read time (k = 5), so a member with three viewers learns
/// nothing about which three.
model ProfileViewDaily {
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId     String
  day           DateTime @db.Date
  views         Int      @default(0)
  byOccupation  Json?
  byGovernorate Json?

  @@id([profileId, day])
  @@index([day])
}

/// A written testimonial.
///
/// Distinct from a Vouch, which sponsors somebody onto the craft ladder and
/// costs the voucher capacity if a dispute is upheld, and from an endorsement,
/// which is a counter. One per (author, subject, occupation): a second
/// testimonial from the same person about the same work is not more evidence.
model Recommendation {
  id              String                 @id @default(cuid())
  author          User                   @relation("RecommendationAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId        String
  subject         User                   @relation("RecommendationSubject", fields: [subjectId], references: [id], onDelete: Cascade)
  subjectId       String
  relationship    RecommendationRelation
  /// "" means "about them generally", not "unknown".
  ///
  /// NOT nullable, and that is load-bearing: this column is part of the unique
  /// below, and Postgres treats NULLs as distinct -- a nullable version would
  /// compile, look right, and let one author publish unlimited general
  /// testimonials about the same person. Same trap as the follow graph's
  /// targetKey.
  occupationKey   String                 @default("")
  body            String                 @db.Text
  status          RecommendationStatus   @default(PENDING)
  requestedAt     DateTime?
  respondedAt     DateTime?
  /// The subject may hide a published recommendation. They may never edit it --
  /// a testimonial the subject can rewrite is not a testimonial.
  hiddenBySubject Boolean                @default(false)
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@unique([authorId, subjectId, occupationKey])
  @@index([subjectId, status, hiddenBySubject])
  @@index([authorId])
}

/// One row per (user, method).
model Verification {
  id            String             @id @default(cuid())
  user          User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  method        VerificationMethod
  status        VerificationStatus @default(PENDING)
  /// What was verified: the phone number, the email domain, the body key.
  evidenceRef   String
  verifiedAt    DateTime?
  expiresAt     DateTime?
  attempts      Int                @default(0)
  lastAttemptAt DateTime?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  @@unique([userId, method])
  @@index([status, expiresAt])
}

/// Short-lived one-time codes. Hash only -- the code is never stored, because
/// a leaked table of live OTPs is a leaked table of accounts.
model PhoneOtp {
  id         String     @id @default(cuid())
  phoneE164  String
  codeHash   String
  purpose    OtpPurpose
  /// WorkProof id when purpose = WORK_PROOF_CONFIRM.
  refId      String?
  expiresAt  DateTime
  consumedAt DateTime?
  attempts   Int        @default(0)
  createdAt  DateTime   @default(now())

  @@index([phoneE164, purpose, expiresAt])
  @@index([expiresAt])
}

model Experience {
  id           String          @id @default(cuid())
  profile      Profile         @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  title        String
  companyName  String
  company      Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId    String?
  location     String?
  locationMode JobLocationMode @default(ONSITE)
  startDate    DateTime
  endDate      DateTime?
  description  String?         @db.Text
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([profileId])
  @@index([companyId])
}

model Education {
  id           String    @id @default(cuid())
  profile      Profile   @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  school       String
  degree       String?
  fieldOfStudy String?
  startDate    DateTime?
  endDate      DateTime?
  description  String?   @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([profileId])
}

/// A skill, and the cluster it belongs to.
///
/// Free text fragments: "JS", "Javascript", and jafaskribt in Arabic are one
/// skill typed three ways, and endorsements scatter across the fragments so
/// nobody has a number that means anything. `foldedName` is `arabicFold(name)`
/// and is what clusters them; `canonicalId` points an alias at the member of
/// its cluster that existed first.
model Skill {
  id          String         @id @default(cuid())
  name        String         @unique
  slug        String         @unique
  /// arabicFold(name). Not unique: the whole point is that several rows share
  /// one, and the canonical row is the oldest of them.
  foldedName  String         @default("")
  /// Null on a canonical row. Set on an alias, pointing at its canonical.
  canonicalId String?
  canonical   Skill?         @relation("SkillCanonical", fields: [canonicalId], references: [id], onDelete: SetNull)
  aliases     Skill[]        @relation("SkillCanonical")
  createdAt   DateTime       @default(now())
  profiles    ProfileSkill[]

  @@index([foldedName])
  @@index([canonicalId])
}

model ProfileSkill {
  profile      Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId    String
  skill        Skill   @relation(fields: [skillId], references: [id], onDelete: Cascade)
  skillId      String
  endorsements Int     @default(0)

  @@id([profileId, skillId])
  @@index([skillId])
}

// ──────────────────────────────────────────────────────────────────────────
// Social graph
// ──────────────────────────────────────────────────────────────────────────

model Connection {
  id          String           @id @default(cuid())
  requester   User             @relation("ConnectionRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  requesterId String
  receiver    User             @relation("ConnectionReceiver", fields: [receiverId], references: [id], onDelete: Cascade)
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  message     String?          @db.Text
  createdAt   DateTime         @default(now())
  respondedAt DateTime?
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@index([requesterId, status])
  @@index([status, createdAt])
}

model BlockedUser {
  id        String   @id @default(cuid())
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blockerId String
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blockedId String
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockedId])
}

// ──────────────────────────────────────────────────────────────────────────
// Content
// ──────────────────────────────────────────────────────────────────────────

model Post {
  id           String    @id @default(cuid())
  // Work portfolio rides on posts: photos are the CV for most crafts, and this
  // way the portfolio inherits feed distribution, comments and reactions.
  // ponytail: no ordering or curation. Add a join table only if members ask to
  // reorder their samples.
  isWorkSample Boolean   @default(false)
  author       User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId     String
  body         String    @db.Text
  language     String    @default("ar")
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  media     Media[]
  reactions Reaction[]
  comments  Comment[]
  topics    PostTopic[]
  reposts   Repost[]
  bookmarks Bookmark[]
  // FTS: raw SQL GIN index on body added in a later migration.

  @@index([authorId, createdAt])
  @@index([createdAt])
  @@index([authorId, deletedAt, createdAt])
}

model Media {
  id         String    @id @default(cuid())
  post       Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId     String?
  url        String
  kind       MediaKind
  mimeType   String
  width      Int?
  height     Int?
  durationMs Int?
  sizeBytes  Int?
  blurhash   String?
  createdAt  DateTime  @default(now())

  @@index([postId])
}

model Reaction {
  id        String       @id @default(cuid())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post         @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  type      ReactionType @default(LIKE)
  createdAt DateTime     @default(now())

  @@unique([userId, postId])
  @@index([postId, type])
}

model Comment {
  id        String    @id @default(cuid())
  author    User      @relation(fields: [authorId], references: [id], onDelete: Cascade)
  authorId  String
  post      Post      @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  parent    Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  parentId  String?
  replies   Comment[] @relation("CommentReplies")
  body      String    @db.Text
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  @@index([postId, createdAt])
  @@index([authorId])
}

model Repost {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([postId])
}

model Bookmark {
  id        String       @id @default(cuid())
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  type      BookmarkType
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId    String?
  job       Job?         @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId     String?
  createdAt DateTime     @default(now())

  @@index([userId, createdAt])
  @@index([postId])
  @@index([jobId])
}

// ──────────────────────────────────────────────────────────────────────────
// Messaging
// ──────────────────────────────────────────────────────────────────────────

model ChatRoom {
  id        String   @id @default(cuid())
  isGroup   Boolean  @default(false)
  title     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members  ChatRoomMember[]
  messages Message[]
}

model ChatRoomMember {
  id                String    @id @default(cuid())
  room              ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId            String
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId            String
  joinedAt          DateTime  @default(now())
  lastReadAt        DateTime?
  // Denormalized cursor for O(1) unread counts. Updated whenever the user
  // reads or sends a message in the room. NULL = never read anything.
  lastReadMessageId String?
  mutedUntil        DateTime?
  archivedAt        DateTime?

  @@unique([roomId, userId])
  @@index([userId])
  @@index([userId, roomId])
}

model Message {
  id              String    @id @default(cuid())
  room            ChatRoom  @relation(fields: [roomId], references: [id], onDelete: Cascade)
  roomId          String
  author          User      @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  authorId        String
  body            String    @db.Text
  mediaUrl        String?
  clientMessageId String?
  createdAt       DateTime  @default(now())
  editedAt        DateTime?
  deletedAt       DateTime?

  @@unique([roomId, authorId, clientMessageId])
  @@index([roomId, createdAt])
  @@index([authorId])
}

// ──────────────────────────────────────────────────────────────────────────
// Notifications
// ──────────────────────────────────────────────────────────────────────────

model Notification {
  id           String           @id @default(cuid())
  recipient    User             @relation("NotificationRecipient", fields: [recipientId], references: [id], onDelete: Cascade)
  recipientId  String
  actor        User?            @relation("NotificationActor", fields: [actorId], references: [id], onDelete: SetNull)
  actorId      String?
  type         NotificationType
  // polymorphic reference — one of these is set
  postId       String?
  commentId    String?
  connectionId String?
  messageId    String?
  jobId        String?
  data         Json?
  readAt       DateTime?
  dismissedAt  DateTime?
  // Stable hash of (type, actorId, postId, commentId, connectionId, messageId,
  // jobId) used to collapse duplicate unread notifications without a 10-field
  // findFirst. NULL when dedupe is disabled for the emit call.
  dedupeKey    String?
  createdAt    DateTime         @default(now())

  @@index([recipientId, readAt])
  @@index([recipientId, dismissedAt])
  @@index([recipientId, createdAt])
  @@index([recipientId, readAt, createdAt])
  @@index([recipientId, dedupeKey, readAt, dismissedAt])
}

model DeviceToken {
  id        String         @id @default(cuid())
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  platform  DevicePlatform
  token     String         @unique
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@index([userId])
}

// ──────────────────────────────────────────────────────────────────────────
// Jobs
// ──────────────────────────────────────────────────────────────────────────

model Company {
  id         String      @id @default(cuid())
  slug       String      @unique
  kind       CompanyKind @default(EMPLOYER)
  name       String
  tagline    String?
  about      String?     @db.Text
  website    String?
  industry   String?
  sizeBucket String? // "1-10", "11-50", ...
  logoUrl    String?
  coverUrl   String?
  country    String      @default("PS")
  city       String?
  verified   Boolean     @default(false)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  members       CompanyMember[]
  jobs          Job[]
  experiences   Experience[]
  subscriptions Subscription[]
  invoices      Invoice[]
  credits       EmployerCredit[]
  workProofs    WorkProof[]
  licences      Licence[]
  followers     Follow[]

  @@index([name])
  @@index([kind])
}

model CompanyMember {
  id        String            @id @default(cuid())
  company   Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  role      CompanyMemberRole @default(EDITOR)
  createdAt DateTime          @default(now())

  @@unique([companyId, userId])
  @@index([userId])
}

model Job {
  id                 String          @id @default(cuid())
  // Nullable on purpose: this one column is what lets an individual post
  // "need someone to rewire two rooms in Ramallah". postedById already carries
  // the human. Application -> HIRED -> two-sided UserRating then works
  // unchanged, which is where WorkProof gets its data.
  company            Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId          String?
  postedBy           User            @relation("JobPoster", fields: [postedById], references: [id], onDelete: Cascade)
  postedById         String
  title              String
  description        String          @db.Text
  type               JobType
  locationMode       JobLocationMode
  city               String?
  country            String          @default("PS")
  // Structured requirements. Without these nothing can be matched: the old
  // skillsRequired String[] is free text and stays only for the long tail.
  occupationKey      String?
  minStanding        Int?
  requiresLicence    Boolean         @default(false)
  licenceBodyKey     String?
  // salaryMin/Max are a range *in payBasis*. MONTHLY default keeps every
  // existing row's meaning, so there is no data migration.
  payBasis           PayBasis        @default(MONTHLY)
  salaryMin          Int?
  salaryMax          Int?
  salaryCurrency     String?         @default("ILS")
  skillsRequired     String[]
  mustSkills         String[]
  startsAt           DateTime?
  durationDays       Int?
  screeningQuestions Json?
  isActive           Boolean         @default(true)
  expiresAt          DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  deletedAt          DateTime?

  applications Application[]
  bookmarks    Bookmark[]
  workProofs   WorkProof[]
  // FTS: raw SQL GIN index on (title || description) added in a later migration.

  @@index([companyId])
  @@index([isActive, createdAt])
  @@index([occupationKey, isActive])
  @@index([type, isActive])
}

// Saved job search → notification on matching new job. All filter fields are
// optional; creation requires at least one (enforced in the shared schema).
model JobAlert {
  id           String           @id @default(cuid())
  user         User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  q            String?
  city         String?
  type         JobType?
  locationMode JobLocationMode?
  industry     String?
  createdAt    DateTime         @default(now())

  @@index([userId])
}

model Application {
  id               String            @id @default(cuid())
  job              Job               @relation(fields: [jobId], references: [id], onDelete: Cascade)
  jobId            String
  applicant        User              @relation(fields: [applicantId], references: [id], onDelete: Cascade)
  applicantId      String
  resumeUrl        String?
  coverLetter      String?           @db.Text
  // Structure the employer currently reconstructs by reading PDFs.
  screeningAnswers Json?
  expectedPay      Int?
  expectedPayBasis PayBasis?
  availableFrom    DateTime?
  attachedProofIds String[]
  portfolioPostIds String[]
  // The score AS COMPUTED AT SUBMISSION, with its weights version. Frozen, so a
  // later profile edit or a weight change cannot rewrite a past decision.
  matchSnapshot    Json?
  status           ApplicationStatus @default(SUBMITTED)
  // Set together, cleared together, and only ever on REJECTED. The note is the
  // free text OTHER needs to mean anything to the applicant.
  rejectionReason  RejectionReason?
  rejectionNote    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  workProofs WorkProof[]

  @@unique([jobId, applicantId])
  @@index([applicantId])
  @@index([jobId, status])
}

// ──────────────────────────────────────────────────────────────────────────
// Moderation
// ──────────────────────────────────────────────────────────────────────────

model Report {
  id              String       @id @default(cuid())
  reporter        User         @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reporterId      String
  reason          ReportReason
  details         String?      @db.Text
  targetUserId    String?
  targetPostId    String?
  targetCommentId String?
  targetMessageId String?
  resolvedAt      DateTime?
  resolvedNote    String?      @db.Text
  createdAt       DateTime     @default(now())

  @@index([reporterId])
  @@index([resolvedAt])
}

model ModerationAction {
  id           String   @id @default(cuid())
  actorId      String
  reportId     String?
  action       String
  note         String?  @db.Text
  targetUserId String?
  createdAt    DateTime @default(now())

  @@index([reportId])
  @@index([actorId])
  @@index([targetUserId])
  @@index([createdAt])
}

// ──────────────────────────────────────────────────────────────────────────
// Monetization — plans, subscriptions, invoices, payments, Karama Points,
// peer ratings. Source of truth is the ledger / invoice tables; balances
// denormalize for fast reads.
// ──────────────────────────────────────────────────────────────────────────

model Plan {
  id           String   @id @default(cuid())
  code         PlanCode @unique
  name         String
  priceCents   Int      @default(0)
  currency     String   @default("USD")
  intervalDays Int? // null = one-off (e.g. featured slot)
  features     Json
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  subscriptions Subscription[]
  invoices      Invoice[]
}

model Subscription {
  id                     String             @id @default(cuid())
  user                   User?              @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId                 String?
  company                Company?           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId              String?
  plan                   Plan               @relation(fields: [planId], references: [id])
  planId                 String
  status                 SubscriptionStatus @default(INCOMPLETE)
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  providerSubscriptionId String?
  cancelAtPeriodEnd      Boolean            @default(false)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  invoices Invoice[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model Invoice {
  id                String        @id @default(cuid())
  subscription      Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  subscriptionId    String?
  plan              Plan?         @relation(fields: [planId], references: [id])
  planId            String?
  user              User?         @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId            String?
  company           Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId         String?
  amountCents       Int
  currency          String        @default("USD")
  status            InvoiceStatus @default(OPEN)
  method            PaymentMethod @default(CARD)
  providerInvoiceId String?
  bankReceiptUrl    String?
  dueAt             DateTime?
  paidAt            DateTime?
  pdfUrl            String?
  // Operator review audit trail (bank-transfer review queue): who approved or
  // voided the invoice, when, and the stated reason. Null for automated paths.
  reviewedById      String?
  reviewedAt        DateTime?
  reviewNote        String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  payments Payment[]

  @@index([userId])
  @@index([companyId])
  @@index([status])
}

model Payment {
  id                String   @id @default(cuid())
  invoice           Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  invoiceId         String
  providerPaymentId String?
  amountCents       Int
  currency          String   @default("USD")
  status            String // provider-specific status string
  rawPayload        Json?
  createdAt         DateTime @default(now())

  @@index([invoiceId])
}

model EmployerCredit {
  id        String             @id @default(cuid())
  company   Company            @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId String
  kind      EmployerCreditKind
  remaining Int                @default(0)
  expiresAt DateTime?
  createdAt DateTime           @default(now())

  @@index([companyId, kind])
}

model KaramaLedger {
  id           String       @id @default(cuid())
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  delta        Int
  balanceAfter Int
  reason       KaramaReason
  refType      String?
  refId        String?
  createdAt    DateTime     @default(now())

  @@unique([userId, reason, refType, refId])
  @@index([userId, createdAt])
  @@index([reason])
}

model UserRating {
  id            String        @id @default(cuid())
  rater         User          @relation("RatingRater", fields: [raterId], references: [id], onDelete: Cascade)
  raterId       String
  ratee         User          @relation("RatingRatee", fields: [rateeId], references: [id], onDelete: Cascade)
  rateeId       String
  context       RatingContext
  score         Int // 1–5
  comment       String?       @db.Text
  jobId         String?
  applicationId String?
  createdAt     DateTime      @default(now())

  @@unique([raterId, rateeId, context, jobId])
  @@index([rateeId, context])
  @@index([raterId])
}

// ──────────────────────────────────────────────────────────────────────────
// Occupations, standing and evidence
//
// docs/design/OCCUPATIONS.md is the decision record. The naming spine there is
// law: one concept, one word, and scripts/check-naming.mjs fails CI on a
// synonym. Occupation keys are constants in @baydar/shared, not a table --
// same reasoning as PS_CITIES.
// ──────────────────────────────────────────────────────────────────────────

// A member's claim on an occupation. Declared, unproven -- rendered as
// «مهنة معلنة». Evidence is what turns it into a Standing or backs a Licence.
model OccupationClaim {
  profile       Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  profileId     String
  occupationKey String
  declaredYears Int?
  isPrimary     Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@id([profileId, occupationKey])
  @@index([occupationKey])
}

// One finished unit of work a counterparty confirmed. THE evidence primitive:
// all three tracks accumulate these and differ only in how they are summarised.
//
// Counted once, keyed on (workerId, occupationKey, applicationId) -- a hire
// status toggled HIRED -> REJECTED -> HIRED advances nothing the second time.
// That is the exact attack that minted Karama in the round-2 review.
model WorkProof {
  id               String          @id @default(cuid())
  worker           User            @relation("WorkProofWorker", fields: [workerId], references: [id], onDelete: Cascade)
  workerId         String
  // Who confirms. Exactly one of these is set; the worker may never be either.
  clientUser       User?           @relation("WorkProofClient", fields: [clientUserId], references: [id], onDelete: SetNull)
  clientUserId     String?
  clientCompany    Company?        @relation(fields: [clientCompanyId], references: [id], onDelete: SetNull)
  clientCompanyId  String?
  /// SHA-256 of the E.164 number, for a client who is not on Baydar. The number
  /// itself is never stored: a table of phone numbers belonging to people who
  /// never signed up is somebody else's data, and it only exists here to route
  /// one OTP and to stop the same client being counted twice.
  clientPhoneHash  String?
  occupationKey    String
  job              Job?            @relation(fields: [jobId], references: [id], onDelete: SetNull)
  jobId            String?
  application      Application?    @relation(fields: [applicationId], references: [id], onDelete: SetNull)
  applicationId    String?
  city             String?
  summary          String?         @db.Text
  status           WorkProofStatus @default(PENDING)
  completedAt      DateTime?
  // Confirmation is bounded: an unanswered request expires rather than hanging
  // around as leverage.
  confirmExpiresAt DateTime?
  confirmedAt      DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@unique([workerId, occupationKey, applicationId])
  @@index([workerId, occupationKey, status])
  @@index([clientUserId])
  @@index([status, confirmExpiresAt])
}

// Earned level, CRAFT track only -- 1..4. One row per (user, occupation),
// written only on transition so the "you advanced" notification has a diff.
// Never recomputed on read, never decays, and no billing or karama code path
// may write it.
model Standing {
  id            String         @id @default(cuid())
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String
  occupationKey String
  value         Int
  reason        StandingReason @default(EARNED)
  // Set when an upheld report suspends the standing. Suspension, not decay.
  suspendedAt   DateTime?
  attainedAt    DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, occupationKey])
  @@index([occupationKey, value])
}

// A معلّم sponsoring someone onto the ladder. Skin in the game: if the vouchee's
// work is disputed and upheld, the voucher loses vouch capacity for a window,
// or this is a favour economy.
model Vouch {
  id            String    @id @default(cuid())
  voucher       User      @relation("VouchVoucher", fields: [voucherId], references: [id], onDelete: Cascade)
  voucherId     String
  vouchee       User      @relation("VouchVouchee", fields: [voucheeId], references: [id], onDelete: Cascade)
  voucheeId     String
  occupationKey String
  note          String?   @db.Text
  revokedAt     DateTime?
  createdAt     DateTime  @default(now())

  @@unique([voucherId, voucheeId, occupationKey])
  @@index([voucheeId, occupationKey])
}

// Statutory practice licence, LICENSED track only. Baydar verifies; it never
// invents a rank beside a نقابة. Body keys are constants in @baydar/shared.
// Held by a member, or by a FIRM for its practice.
model Licence {
  id            String         @id @default(cuid())
  user          User?          @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId        String?
  company       Company?       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId     String?
  occupationKey String
  bodyKey       String
  number        String?
  status        LicenceStatus  @default(DECLARED)
  practice      PracticeStatus @default(PRACTISING)
  issuedAt      DateTime?
  expiresAt     DateTime?
  verifiedAt    DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@unique([userId, occupationKey, bodyKey])
  @@index([companyId])
  @@index([status, expiresAt])
}

// ──────────────────────────────────────────────────────────────────────────
// Feed ranking -- docs/design/FEED-RANKING.md
// ──────────────────────────────────────────────────────────────────────────

// Deterministic tags written once on post create. No ML, no model to host:
// author occupations, hashtags, company mentions, folded-Arabic taxonomy match,
// and the author's governorate.
model PostTopic {
  post     Post        @relation(fields: [postId], references: [id], onDelete: Cascade)
  postId   String
  topicKey String
  source   TopicSource

  @@id([postId, topicKey])
  @@index([topicKey])
}

// Sparse topic interest, updated by EWMA on signal arrival and decayed on read.
// Embeddings would rank marginally better and cost the ability to say WHY a
// post was shown, which is the whole reason ranking is acceptable here.
// ponytail: sparse topics in Postgres; revisit only if explainability stops
// being a product requirement.
model InterestWeight {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  topicKey  String
  weight    Float    @default(0)
  updatedAt DateTime @updatedAt

  @@id([userId, topicKey])
  @@index([userId, weight])
}

// A frozen ranked page order. Score-ordered results plus a cursor duplicates
// and skips posts, because cursor pagination assumes a stable total order and a
// ranked feed has none. Paging walks an offset into postIds instead.
model FeedSlate {
  id          String   @id @default(cuid())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  postIds     String[]
  generatedAt DateTime @default(now())
  expiresAt   DateTime

  @@index([userId, generatedAt])
  @@index([expiresAt])
}

// Negative feedback. Without a correction signal the interest model has no way
// to be wrong, so this ships with the model, not after it.
model TopicMute {
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  topicKey  String
  createdAt DateTime @default(now())

  @@id([userId, topicKey])
}
