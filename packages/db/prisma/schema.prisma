enum SignalKind {
  POST_EXPAND
  POST_DWELL
  LINK_CLICK
  PROFILE_VISIT
  SEARCH_QUERY
  JOB_APPLY
  NOT_INTERESTED
  HIDE_POST
}

enum RequirementLevel {
  MUST
  NICE
}

enum JobLocationMode {
  ONSITE
