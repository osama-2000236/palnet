{
  "name": "@baydar/ui-tokens",
  "version": "0.0.1",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native": "./src/tokens.native.ts",
    "./tokens.css": "./src/tokens.css",
    "./tailwind-preset": {
      "types": "./dist/tailwind-preset.d.ts",
      "default": "./tailwind-preset.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "native": [
        "src/tokens.native.ts"
      ],
      "tailwind-preset": [
        "dist/tailwind-preset.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "src/tokens.css"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "lint": "eslint .",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@baydar/config": "workspace:*",
    "rimraf": "^6.0.1",
    "typescript": "~5.9.2"
  }
}
