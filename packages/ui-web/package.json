{
  "name": "@baydar/ui-web",
  "version": "0.0.1",
  "private": true,
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "clean": "rimraf dist",
    "lint": "eslint . --cache --cache-location node_modules/.cache/eslint/",
    "type-check": "tsc --noEmit",
    "test": "tsc -p tsconfig.json && node ../../apps/web/node_modules/jest/bin/jest.js --config jest.config.cjs --runInBand"
  },
  "dependencies": {
    "@baydar/ui-tokens": "workspace:*",
    "clsx": "^2.1.1",
    "tailwind-merge": "^2.5.4"
  },
  "peerDependencies": {
    "react": "^19.1.0"
  },
  "devDependencies": {
    "@baydar/config": "workspace:*",
    "@types/react": "~19.1.10",
    "@types/react-dom": "~19.1.10",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "rimraf": "^6.0.1",
    "typescript": "^5.6.0"
  }
}
