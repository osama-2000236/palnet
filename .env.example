# ──────────────────────────────────────────────────────────────
# Baydar — .env.example
# Copy to .env.local (gitignored). Never commit real secrets.
# Prod values live in Render/Vercel/EAS env panels.
# ──────────────────────────────────────────────────────────────

# Shared
NODE_ENV=development

# ─── Database (Neon) ───
DATABASE_URL=postgresql://user:password@localhost:5432/baydar?schema=public
DIRECT_URL=postgresql://user:password@localhost:5432/baydar?schema=public

# ─── API (NestJS) ───
API_PORT=4000
API_BASE_URL=http://localhost:4000
CORS_ORIGINS=http://localhost:3000,http://localhost:8081,http://localhost:8082

JWT_ACCESS_SECRET=change-me-access-32chars-min
JWT_REFRESH_SECRET=change-me-refresh-32chars-min
JWT_ACCESS_TTL=900
JWT_REFRESH_TTL=2592000

BCRYPT_COST=12
INTERNAL_CRON_TOKEN=change-me-internal-cron-token-32chars

# ─── Mail (Resend in production; console transport in dev/test) ───
RESEND_API_KEY=
MAIL_FROM=Baydar <noreply@baydar.ps>
MAIL_REPLY_TO=support@baydar.ps
BAYDAR_WEB_URL=http://localhost:3000

# ─── Billing ───
HYPERPAY_ENTITY_ID=
HYPERPAY_ACCESS_TOKEN=
HYPERPAY_WEBHOOK_SECRET=
HYPERPAY_BASE_URL=https://eu-test.oppwa.com
BANK_TRANSFER_IBAN=
BANK_TRANSFER_BENEFICIARY=Baydar

# ─── OAuth (Sprint 1.5) ───
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/api/v1/auth/google/callback

# ─── Cloudflare R2 (S3-compatible) ───
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=baydar-media-dev
R2_PUBLIC_URL=https://media.baydar.ps
CLAMAV_SCAN_URL=http://clamav:3310/scan
CLOUDFLARE_IMAGES_SCAN_URL=

# ─── Observability ───
SENTRY_DSN=
SENTRY_RELEASE=local-dev

# ─── Web (Next.js) ───
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_WS_URL=http://localhost:4000
NEXT_PUBLIC_DEFAULT_LOCALE=ar-PS
NEXT_PUBLIC_SENTRY_DSN=
NEXT_PUBLIC_SENTRY_RELEASE=local-dev

# ─── Mobile (Expo) ───
EXPO_PUBLIC_API_URL=http://localhost:4000/api/v1
EXPO_PUBLIC_WS_URL=http://localhost:4000
EXPO_PUBLIC_DEFAULT_LOCALE=ar-PS
EXPO_PUBLIC_SENTRY_DSN=
EXPO_PUBLIC_SENTRY_RELEASE=local-dev
