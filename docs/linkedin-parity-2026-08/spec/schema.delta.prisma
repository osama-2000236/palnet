  ENDED
}

enum RsvpState {
  GOING
  INTERESTED
  NOT_GOING
}

model Group {
  id                 String          @id @default(cuid())
  slug               String          @unique
  kind               GroupKind
  privacy            GroupPrivacy    @default(PUBLIC)
  joinPolicy         GroupJoinPolicy @default(OPEN)
  nameAr             String
  nameEn             String
  about              String?         @db.Text
  coverUrl           String?
  governorateKey     String?
  bodyKey            String?
  universityKey      String?
  familyKey          String?
  genderSegregated   Boolean         @default(false)
  memberCount        Int             @default(0)
  postCount          Int             @default(0)
  createdById        String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  members GroupMember[]
  events  Event[]
  rules   GroupRule[]

  @@index([kind, privacy])
  @@index([governorateKey])
  @@index([bodyKey])
  @@index([universityKey])
  @@index([familyKey])
}

model GroupMember {
  group    Group            @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId  String
  user     User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId   String
  role     GroupRole        @default(MEMBER)
  state    GroupMemberState @default(ACTIVE)
  joinedAt DateTime         @default(now())

  @@id([groupId, userId])
  @@index([userId, state])
  @@index([groupId, role])
}

model GroupRule {
  id      String @id @default(cuid())
  group   Group  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  groupId String
  ordinal Int
  text    String @db.Text

  @@unique([groupId, ordinal])
}

model Event {
  id             String      @id @default(cuid())
  group          Group?      @relation(fields: [groupId], references: [id], onDelete: SetNull)
  groupId        String?
  host           User        @relation(fields: [hostId], references: [id], onDelete: Cascade)
  hostId         String
  company        Company?    @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId      String?
  slug           String      @unique
  title          String
  about          String?     @db.Text
  mode           EventMode
  governorateKey String?
  venue          String?
  joinUrl        String?
  startsAt       DateTime
  endsAt         DateTime
  timezone       String      @default("Asia/Hebron")
  capacity       Int?
  status         EventStatus @default(DRAFT)
  coverUrl       String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  attendees EventAttendee[]

  @@index([status, startsAt])
  @@index([governorateKey, startsAt])
  @@index([groupId, startsAt])
}

model EventAttendee {
  event      Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  eventId    String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId     String
  state      RsvpState
  attendedAt DateTime?
  createdAt  DateTime  @default(now())

  @@id([eventId, userId])
  @@index([userId, state])
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 8 — WS-07 services
// migration: add_services
// ═══════════════════════════════════════════════════════════════════════════

enum ServicePricingModel {
  FIXED
  HOURLY
  DAILY
  PER_UNIT
  QUOTE_ONLY
}

enum InquiryState {
  OPEN
  RESPONDED
  ACCEPTED
  DECLINED
  CLOSED
  EXPIRED
}

model ServiceListing {
  id                 String              @id @default(cuid())
  provider           User                @relation(fields: [providerId], references: [id], onDelete: Cascade)
  providerId         String
  company            Company?            @relation(fields: [companyId], references: [id], onDelete: SetNull)
  companyId          String?
  occupationKey      String
  slug               String              @unique
  titleAr            String
  titleEn            String?
  description        String              @db.Text
  pricingModel       ServicePricingModel
  priceMin           Int?
  priceMax           Int?
  currency           String              @default("ILS")
  unitLabelKey       String?
  servesAtClientSite Boolean             @default(false)
  hasWorkshop        Boolean             @default(false)
  remoteCapable      Boolean             @default(false)
  governorateKeys    String[]
  turnaroundDays     Int?
  samplePostIds      String[]
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  inquiries ServiceInquiry[]

  @@index([occupationKey, isActive])
  @@index([providerId])
  @@index([remoteCapable, isActive])
}

model ServiceInquiry {
  id             String         @id @default(cuid())
  listing        ServiceListing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  listingId      String
  client         User           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  clientId       String
  summary        String         @db.Text
  governorateKey String?
  neededBy       DateTime?
  budgetMin      Int?
  budgetMax      Int?
  currency       String         @default("ILS")
  attachmentUrls String[]
  state          InquiryState   @default(OPEN)
  roomId         String?
  workProofId    String?
  respondedAt    DateTime?
  expiresAt      DateTime
  createdAt      DateTime       @default(now())

  @@index([listingId, state])
  @@index([clientId, state])
  @@index([state, expiresAt])
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 9 — WS-08 learning
// migration: add_learning
// ═══════════════════════════════════════════════════════════════════════════

enum LessonFormat {
  TEXT
  AUDIO
  TEXT_AUDIO
}

enum PathLevel {
  FOUNDATION
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentState {
  ACTIVE
  COMPLETED
  ABANDONED
}

model Path {
  id                String    @id @default(cuid())
  slug              String    @unique
  titleAr           String
  titleEn           String?
  about             String    @db.Text
  level             PathLevel
  occupationKeys    String[]
  familyKeys        String[]
  coverUrl          String?
  estimatedMin      Int
  issuesCertificate Boolean   @default(false)
  certificateName   String?
  sponsorCompanyId  String?
  isPublished       Boolean   @default(false)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  lessons     Lesson[]
  enrollments Enrollment[]

  @@index([isPublished, level])
}

model Lesson {
  id           String           @id @default(cuid())
  path         Path             @relation(fields: [pathId], references: [id], onDelete: Cascade)
  pathId       String
  ordinal      Int
  titleAr      String
  format       LessonFormat
  bodyMarkdown String?          @db.Text
  audioUrl     String?
  audioSeconds Int?
  estimatedMin Int
  progress     LessonProgress[]

  @@unique([pathId, ordinal])
}

model Enrollment {
  path        Path            @relation(fields: [pathId], references: [id], onDelete: Cascade)
  pathId      String
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  state       EnrollmentState @default(ACTIVE)
  startedAt   DateTime        @default(now())
  completedAt DateTime?

  @@id([pathId, userId])
  @@index([userId, state])
}

model LessonProgress {
  lesson      Lesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  lessonId    String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId      String
  completedAt DateTime @default(now())

  @@id([lessonId, userId])
  @@index([userId])
}

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 10 — WS-09 monetisation
// migration: add_promotions_and_fx
// ═══════════════════════════════════════════════════════════════════════════

enum PromotionKind {
  JOB
  POST
}

enum PromotionStatus {
  DRAFT
  ACTIVE
  PAUSED
  ENDED
}

model Promotion {
  id              String          @id @default(cuid())
  kind            PromotionKind
  company         Company?        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  companyId       String?
  createdById     String
  jobId           String?
  postId          String?
  governorateKeys String[]
  occupationKeys  String[]
  budgetMinor     Int
  spentMinor      Int             @default(0)
  currency        String          @default("ILS")
  startsAt        DateTime
  endsAt          DateTime
  status          PromotionStatus @default(DRAFT)
  impressions     Int             @default(0)
  clicks          Int             @default(0)
  createdAt       DateTime        @default(now())

  @@index([status, startsAt, endsAt])
}

