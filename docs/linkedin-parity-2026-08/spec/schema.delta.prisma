  createdAt DateTime @default(now())

  @@index([userId])
}

// Anonymised wage aggregate. Deliberately carries NO joinable identifier —
// not a job id, not a user id — so the table cannot be reversed onto a person
// or an employer. k-anonymity at read (k = 7) is the second control.
model WageObservation {
  id             String   @id @default(cuid())
  occupationKey  String
  governorateKey String
  payBasis       PayBasis
  currency       String
  amount         Int
  sourceKind     String
  observedAt     DateTime @default(now())

  @@index([occupationKey, governorateKey, payBasis, observedAt])
}

model Appeal {
  id                 String      @id @default(cuid())
  subjectUserId      String
  moderationActionId String?
  body               String      @db.Text
  state              AppealState @default(OPEN)
  reviewedById       String?
  reviewedAt         DateTime?
  decision           String?     @db.Text
  createdAt          DateTime    @default(now())

  @@index([state, createdAt])
  @@index([subjectUserId])
}

