// spec/schema.delta.prisma
//
// The complete Prisma delta for the LinkedIn-parity build, in migration order.
// This file is NOT a valid standalone schema — it is the set of additions and
// changes to be merged into packages/db/prisma/schema.prisma.
//
// HOW TO USE
//   Work phase by phase (master spec §20.2). For each phase, merge that
//   phase's block into schema.prisma, run `pnpm --filter @baydar/db db:migrate`
//   with the migration name given in the block header, and commit the
//   migration in the same PR as the schema change. Never merge two phases'
//   blocks into one migration.
//
// INVARIANTS THAT APPLY TO EVERY BLOCK
//   * Every new model gets @@index on every FK it is queried by. A missing
//     index here is a sequential scan on a table that only grows.
//   * Every enum member added to an EXISTING enum is appended, never inserted
//     — Postgres enum ordering is positional and an insert rewrites the type.
//   * No column is dropped in the same migration that adds its replacement.
//     Two-release rule, master spec §19.
//   * Money is always an integer in the currency's MINOR unit. ILS exponent 2,
//     JOD exponent 3, USD exponent 2. See packages/shared/src/money.ts.
//
// Total: 41 new models, 17 new enums, 9 changed models, 4 changed enums.

// ═══════════════════════════════════════════════════════════════════════════
// PHASE 1 — WS-11 low-bandwidth foundation
// migration: add_idempotency
// ═══════════════════════════════════════════════════════════════════════════

// Replay protection for the four durable outbox actions. Stores the original
// response so a replay returns the identical body and status rather than a
// 409 the client cannot act on.
model IdempotencyRecord {
  id           String   @id @default(cuid())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId       String
  key          String
  route        String
  statusCode   Int
  responseBody Json
  createdAt    DateTime @default(now())
  expiresAt    DateTime

  @@unique([userId, key])
  @@index([expiresAt])
}

