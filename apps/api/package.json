{
  "name": "@baydar/api",
  "version": "0.0.1",
  "private": true,
  "description": "Baydar NestJS API — REST + SSE + Swagger",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "pnpm --filter @baydar/ui-tokens build && pnpm --filter @baydar/shared build && pnpm --filter @baydar/db build",
    "build": "nest build",
    "predev": "pnpm --filter @baydar/ui-tokens build && pnpm --filter @baydar/shared build && pnpm --filter @baydar/db build",
    "dev": "nest start --watch",
    "prestart": "pnpm --filter @baydar/ui-tokens build && pnpm --filter @baydar/shared build && pnpm --filter @baydar/db build",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "pretest": "pnpm --filter @baydar/ui-tokens build && pnpm --filter @baydar/shared build && pnpm --filter @baydar/db build",
    "test": "jest",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1032.0",
    "@aws-sdk/s3-request-presigner": "^3.1032.0",
    "@baydar/db": "workspace:*",
    "@baydar/shared": "workspace:*",
    "@baydar/ui-tokens": "workspace:*",
    "@nestjs/common": "^11.1.6",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@nestjs/swagger": "^11.2.0",
    "@nestjs/throttler": "^6.4.0",
    "@sentry/node": "^10.65.0",
    "bcrypt": "^5.1.1",
    "blurhash": "^2.0.5",
    "compression": "^1.7.5",
    "expo-server-sdk": "^6.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.11.1",
    "jsonwebtoken": "^9.0.2",
    "nestjs-pino": "^4.1.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@baydar/config": "workspace:*",
    "@nestjs/cli": "^11.0.10",
    "@nestjs/schematics": "^11.0.9",
    "@nestjs/testing": "^11.1.6",
    "@types/bcrypt": "^5.0.2",
    "@types/compression": "^1.7.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.12",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^22.7.5",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "pino-pretty": "^11.3.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "~5.9.2",
    "eslint": "^9.39.5"
  }
}
